code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_front, diffuse_lambert, specular_schlick_ggx;

uniform float outlinesize = 0.05000000074506;
uniform vec4 base_color : source_color;



void vertex() {
// Input:3
	vec3 n_out3p0 = NORMAL;


// FloatParameter:2
	float n_out2p0 = outlinesize;


// VectorOp:4
	vec3 n_out4p0 = n_out3p0 * vec3(n_out2p0);


// Input:5
	vec3 n_out5p0 = VERTEX;


// VectorOp:6
	vec3 n_out6p0 = n_out4p0 + n_out5p0;


// Output:0
	VERTEX = n_out6p0;


}

void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = base_color;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);


}
